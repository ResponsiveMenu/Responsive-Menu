{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rmp/menu",
	"version": "2.0.0",
	"title": "Responsive Menu",
	"category": "widgets",
	"icon": "menu-alt3",
	"keywords": [
		"responsive",
		"menu",
		"responsive menu",
		"mega menu",
		"max mega menu",
		"max menu",
		"navigation",
		"hamburger"
	],
	"description": "Highly Customisable Responsive Menu Plugin for WordPress",
	"example": {},
	"supports": {
		"html": false,
		"customClassName": true,
		"anchor": true,
		"spacing": {
			"margin": [ "top", "bottom" ]
		}
	},
	"providesContext": {
		"rmp/breakpoint": "breakpoint",
		"rmp/tabletBreakpoint": "tabletBreakpoint",
		"rmp/mobileBreakpoint": "mobileBreakpoint"
	},
	"attributes": {
		"id": {
			"type": "string"
		},
		"menuContainerStyle": {
			"type": "object",
			"default": {
				"color": "#ffffff",
				"background": "#1d4354",
				"backgroundImage": "",
				"backgroundSize": "cover",
				"backgroundPosition": "",
				"backgroundRepeat": "no-repeat",
				"padding": {
					"top": "10px",
					"right": "10px",
					"bottom": "10px",
					"left": "10px"
				},
				"menuWidth": 75,
				"menuMaximumWidth": 350,
				"menuMinimumWidth": 320,
				"autoHeight": false,
				"columns": 1
			}
		},
		"menuAnimation": {
			"type": "object",
			"default": {
				"type": "slide",
				"direction": "left",
				"transitionDuration": 0.5
			}
		},
		"menuBehaviour": {
			"type": "object",
			"default": {
				"linkClick": "",
				"pageScroll": "",
				"pageClick": "",
				"escKey": true,
				"scrollLock": false,
				"focusTrap": true,
				"swipe": false
			}
		},
		"overlay": {
			"type": "object",
			"default": {
				"enabled": false,
				"color": "rgba(0, 0, 0, 0.5)"
			}
		},
		"triggerPosition": {
			"type": "object",
			"default": {
				"type": "relative",
				"distanceFromSide": 0,
				"top": 0,
				"zIndex": 99999
			}
		},
		"breakpoint": {
			"type": "number",
			"default": 768
		},
		"tabletBreakpoint": {
			"type": "number",
			"default": 1024
		},
		"mobileBreakpoint": {
			"type": "number",
			"default": 767
		},
		"hamburgerStyle": {
			"type": "object",
			"default": {
				"type": "hamburger",
				"icon": "wordpress-menu",
				"activeIcon": "wordpress-close",
				"iconSize": "30",
				"image": "",
				"activeImage": "",
				"lineSpacing": 10,
				"lineWidth": 25,
				"lineHeight": 3,
				"width": 55,
				"height": 55,
				"color": "#ffffff",
				"hoverColor": "#ffffff",
				"activeColor": "#ffffff",
				"background": "#1d4354",
				"hoverBackground": "#1d4354",
				"activeBackground": "#6fda44",
				"borderRadius": {
					"top": "5px",
					"right": "5px",
					"bottom": "5px",
					"left": "5px"
				},
				"side": "right"
			}
		},
		"hamburgerText": {
			"type": "object",
			"default": {
				"text": "",
				"activeText": "",
				"position": "left",
				"fontFamily": "",
				"size": 14,
				"lineHeight": 14,
				"color": "",
				"gap": 5
			}
		},
		"responsive": {
			"type": "object",
			"default": {}
		},
		"blockStyles": {
			"type": "object"
		}
	},
	"textdomain": "responsive-menu",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
